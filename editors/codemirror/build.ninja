# build.ninja — the files <yaml-editor> produces: the developer page's screenshots, as every
# component of the collection makes them. The framework comes with the workspace this package
# links (bun link ui-web-component-workspace); the page's server (screenshots.mjs serves it) also
# needs js/dist/nimyaml.mjs, which `node js/build.mjs` at the repository's root makes.
id = yaml-editor
bun = node
webcomponents = node_modules/ui-web-component-workspace/packages/webcomponents

rule screenshot
  command = $bun $webcomponents/screenshots.mjs $in

build screenshots/$id.ar.png: screenshot index.html
build screenshots/$id.en.png: screenshot index.html
build screenshots/$id.tour.en.png: screenshot index.html
