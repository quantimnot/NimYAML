{
  "//": "CBOR diagnostic notation (RFC 8949 §8, RFC 8610 Appendix G), the text form of binary CBOR.",
  "name": "CBOR Diagnostic Notation",
  "scopeName": "source.cbor",
  "fileTypes": ["cbordiag", "diag", "edn"],
  "patterns": [
    { "include": "#value" }
  ],
  "repository": {
    "value": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#embedded" },
        { "include": "#tag" },
        { "include": "#simple" },
        { "include": "#constant" },
        { "include": "#bytes" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#array" },
        { "include": "#map" },
        { "include": "#streaming" },
        { "include": "#encoding" },
        { "include": "#separators" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "(#).*$\\n?",
          "captures": { "1": { "name": "punctuation.definition.comment.cbor" } },
          "name": "comment.line.number-sign.cbor"
        },
        {
          "begin": "/(?!\\s*$)",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.cbor" } },
          "end": "/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.cbor" } },
          "name": "comment.block.cbor"
        }
      ]
    },
    "constant": {
      "match": "\\b(?:true|false|null|undefined)\\b",
      "name": "constant.language.cbor"
    },
    "simple": {
      "begin": "\\b(simple)(\\()",
      "beginCaptures": {
        "1": { "name": "support.function.simple.cbor" },
        "2": { "name": "punctuation.definition.simple.begin.cbor" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.definition.simple.end.cbor" } },
      "name": "meta.simple.cbor",
      "patterns": [{ "include": "#number" }, { "include": "#comments" }]
    },
    "number": {
      "patterns": [
        {
          "match": "-?\\b(?:NaN|Infinity)\\b(?:_[0-3])?",
          "name": "constant.numeric.float.cbor"
        },
        {
          "match": "-?\\b0[xX][0-9a-fA-F]+(?:\\.[0-9a-fA-F]*)?(?:[pP][+-]?\\d+)?(?:_[0-3])?\\b",
          "name": "constant.numeric.hex.cbor"
        },
        {
          "match": "-?\\b0[oO][0-7]+(?:_[0-3])?\\b",
          "name": "constant.numeric.octal.cbor"
        },
        {
          "match": "-?\\b0[bB][01]+(?:_[0-3])?\\b",
          "name": "constant.numeric.binary.cbor"
        },
        {
          "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?(?:_[0-3])?\\b",
          "name": "constant.numeric.cbor"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cbor" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.cbor" } },
      "name": "string.quoted.double.cbor",
      "patterns": [{ "include": "#escape" }]
    },
    "bytes": {
      "patterns": [
        {
          "begin": "\\b(h|b32|h32|b64)(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.cbor" },
            "2": { "name": "punctuation.definition.string.begin.cbor" }
          },
          "end": "'",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.cbor" } },
          "name": "string.quoted.single.bytes.encoded.cbor",
          "patterns": [{ "include": "#comments" }]
        },
        {
          "begin": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cbor" } },
          "end": "'",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.cbor" } },
          "name": "string.quoted.single.bytes.cbor",
          "patterns": [{ "include": "#escape" }]
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "match": "\\\\(?:[\"'\\\\/bfnrt]|u[0-9a-fA-F]{4}|u\\{[0-9a-fA-F]+\\})",
          "name": "constant.character.escape.cbor"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.unrecognized-string-escape.cbor"
        }
      ]
    },
    "tag": {
      "begin": "\\b(\\d+)(?:(_[0-3])?)(\\()",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.cbor" },
        "2": { "name": "storage.modifier.encoding.cbor" },
        "3": { "name": "punctuation.definition.tag.begin.cbor" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.definition.tag.end.cbor" } },
      "name": "meta.tag.cbor",
      "patterns": [{ "include": "#value" }]
    },
    "embedded": {
      "begin": "<<",
      "beginCaptures": { "0": { "name": "punctuation.definition.embedded.begin.cbor" } },
      "end": ">>",
      "endCaptures": { "0": { "name": "punctuation.definition.embedded.end.cbor" } },
      "name": "meta.embedded.sequence.cbor",
      "patterns": [{ "include": "#value" }]
    },
    "array": {
      "begin": "\\[(?:\\s*(_)(?![0-3]))?",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.array.begin.cbor" },
        "1": { "name": "storage.modifier.indefinite.cbor" }
      },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.definition.array.end.cbor" } },
      "name": "meta.structure.array.cbor",
      "patterns": [{ "include": "#value" }]
    },
    "map": {
      "begin": "\\{(?:\\s*(_)(?![0-3]))?",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.dictionary.begin.cbor" },
        "1": { "name": "storage.modifier.indefinite.cbor" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.dictionary.end.cbor" } },
      "name": "meta.structure.dictionary.cbor",
      "patterns": [
        { "match": ":", "name": "punctuation.separator.dictionary.key-value.cbor" },
        { "include": "#value" }
      ]
    },
    "streaming": {
      "begin": "\\(\\s*(_)(?![0-3])",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.streaming.begin.cbor" },
        "1": { "name": "storage.modifier.indefinite.cbor" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.definition.streaming.end.cbor" } },
      "name": "meta.structure.streaming-string.cbor",
      "patterns": [{ "include": "#value" }]
    },
    "encoding": {
      "match": "_[0-3]?\\b",
      "name": "storage.modifier.encoding.cbor"
    },
    "separators": {
      "match": ",",
      "name": "punctuation.separator.cbor"
    }
  }
}
